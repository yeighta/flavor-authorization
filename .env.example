OPENROUTER_API_KEY=your_openrouter_api_key_here
# PDF extraction model (PDF-native models get the file; image-only ones get rendered pages)
# EXTRACT_MODEL=openai/gpt-6-luna
# Text-only tasks (classify / normalize-manufacturers)
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Optional: notifications (cmd/notify)
# DISCORD_WEBHOOK_URL=
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
